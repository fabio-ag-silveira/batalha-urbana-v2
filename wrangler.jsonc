{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "batalha-urbana",
  "compatibility_date": "2026-10-28",
  // Site 100% estatico: sem "main", o Worker so serve os arquivos abaixo.
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  // O deploy cria o registro DNS e o certificado do subdominio automaticamente.
  "routes": [
    { "pattern": "batalha.fabiosilveira.dev", "custom_domain": true }
  ]
}
